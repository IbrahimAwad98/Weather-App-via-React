# Copy this file to .env.local and fill in the value.
# Get a free key at https://openweathermap.org/api — new keys take a few
# minutes to activate.
#
# Server-side only. Do NOT rename this to NEXT_PUBLIC_WEATHER_API_KEY:
# that prefix inlines the value into the client bundle, where every visitor
# can read it.
WEATHER_API_KEY=
